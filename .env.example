# ──────────────────────────────────────────────────────────────
# Cheroot Holidays — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
#
# NEVER commit .env.local — it is already in .gitignore.
# NEVER prefix secrets with NEXT_PUBLIC_ — they must stay server-side.
# ──────────────────────────────────────────────────────────────

# ── Site URL ─────────────────────────────────────────────────
# Required for canonical URLs, sitemaps and OG meta.
# NEXT_PUBLIC_SITE_URL=https://www.cherootholidays.com

# ── Twilio WhatsApp Integration ──────────────────────────────
# Required for sending tour-enquiry notifications via WhatsApp.
# Get credentials from https://console.twilio.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Approved WhatsApp sender number (Twilio sandbox or production).
# Must include the "whatsapp:" prefix, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Cheroot Holidays business WhatsApp number that receives enquiry alerts.
# Must include the "whatsapp:" prefix, e.g. whatsapp:+919876543210
CHEROOT_WHATSAPP_TO=

# ── Enquiry Delivery Provider ─────────────────────────────────
# Controls which provider handles trip enquiry notifications.
#
# preview   — development mode: logs to server console, no external calls.
#             This is the default. Safe for local testing.
# twilio    — production: sends via Twilio WhatsApp (requires credentials above).
#
# In production with no provider configured, the API fails closed (503).
ENQUIRY_DELIVERY_PROVIDER=preview

# Future provider placeholder (populate when provider details are available):
# ENQUIRY_API_BASE_URL=
# ENQUIRY_API_KEY=

# ── Place Search Provider ─────────────────────────────────────
# Controls the location/place autocomplete data source.
#
# local     — default: uses the curated local India-first registry
#             (data/places/india-places.json). No external calls.
# remote    — reserved for future external Places API integration.
#
# When set to "remote", the following keys are also required:
PLACES_PROVIDER=local

# Uncomment and populate when an external Places API is contracted:
# PLACES_API_BASE_URL=
# PLACES_API_KEY=
# NOTE: Keep PLACES_API_KEY server-side. Never use NEXT_PUBLIC_ prefix.
